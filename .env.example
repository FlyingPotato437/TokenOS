# Leave values empty to run the complete local demo engine.
PORT=8787

# EverOS v2 Memory API
EVEROS_API_KEY=
EVEROS_BASE_URL=https://api.evermind.ai
EVEROS_USER_ID=tokenos-demo-user

# Snowflake Cortex REST API
SNOWFLAKE_ACCOUNT_URL=https://your-account.snowflakecomputing.com
SNOWFLAKE_PAT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_LEDGER_TABLE=TOKENOS_RUN_LEDGER

# Optional override for the model selected by TokenOS.
TOKENOS_FORCE_MODEL=
