# Local API port. Optional in every mode; defaults to 8787 when absent.
PORT=8787

# EverOS v2 Memory API
# API key: required only for live EverOS retrieval and interaction writeback.
# Leave empty to use the deterministic catalog; provider failures use the same catalog as fallback.
EVEROS_API_KEY=
# API origin: optional; defaults to https://api.evermind.ai when absent.
EVEROS_BASE_URL=https://api.evermind.ai
# Search user and writeback sender: optional; defaults to tokenos-demo-user when absent.
EVEROS_USER_ID=tokenos-demo-user

# Snowflake Cortex REST API and SQL API
# Account origin and PAT: both are required for live Cortex inference.
# Leave either empty to use deterministic inference with estimated usage and cost.
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# Database and schema: additionally required for the live Snowflake SQL evidence ledger.
# They must already exist. Leave either empty to retain completed runs in the in-process ledger.
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Warehouse and role: optional SQL statement context; Snowflake session defaults apply when empty.
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
# Ledger table: optional; defaults to TOKENOS_RUN_LEDGER when empty or absent.
SNOWFLAKE_LEDGER_TABLE=TOKENOS_RUN_LEDGER

# Optional Cortex model override applied equally to baseline and optimized executions.
# Leave empty to use the compiler's fixed selected model.
TOKENOS_FORCE_MODEL=
