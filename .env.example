# Leave values empty to run the complete local demo engine.
PORT=8787

# EverOS v2 Memory API
EVEROS_API_KEY=
EVEROS_BASE_URL=https://api.evermind.ai
EVEROS_USER_ID=tokenos-demo-user
EVEROS_AGENT_ID=tokenos-raven

# Raven is the fixed execution runtime. The official one-shot command is used.
RAVEN_COMMAND=raven
RAVEN_MODEL=configured-default
RAVEN_WORKSPACE=
RAVEN_TIMEOUT_MS=120000

# Local A/B evidence and learned-case index. This directory is gitignored.
TOKENOS_LEDGER_PATH=.tokenos/run-ledger.jsonl
