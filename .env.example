# HTTP API. Optional; defaults to 8787.
PORT=8787

# EverOS v2 Memory API. All values are optional in deterministic replay mode.
# A key is used only when EVEROS_MODE=live; it does not make Raven live.
EVEROS_MODE=replay
EVEROS_API_KEY=
EVEROS_BASE_URL=https://api.evermind.ai
EVEROS_USER_ID=tokenos-demo-user
EVEROS_AGENT_ID=tokenos-raven
EVEROS_APP_ID=tokenos
EVEROS_PROJECT_ID=raven-demo

# Raven execution. replay is credential-free and is the default.
# live requires an installed, onboarded Raven CLI and Raven's model-provider credentials.
RAVEN_MODE=replay
RAVEN_COMMAND=raven
RAVEN_MODEL=
RAVEN_CONFIG_PATH=
RAVEN_WORKSPACE=
RAVEN_TIMEOUT_MS=

# Local evidence and historical-lift persistence. Optional; this is the default.
TOKENOS_LEDGER_PATH=.tokenos/run-ledger.jsonl
